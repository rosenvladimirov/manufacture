<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_mrp_bom_stage_tree" model="ir.ui.view">
        <field name="name">mrp.bom.stage.tree</field>
        <field name="model">mrp.bom.stage</field>
        <field name="arch" type="xml">
            <list string="BOM stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_common"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_mrp_bom_stage_form" model="ir.ui.view">
        <field name="name">mrp.bom.stage.form</field>
        <field name="model">mrp.bom.stage</field>
        <field name="arch" type="xml">
            <form string="BOM stage">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived"
                                bg_color="bg-danger"
                                invisible="active"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_common"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description of the stage..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mrp_bom_stage" model="ir.actions.act_window">
        <field name="name">BOM stages</field>
        <field name="res_model">mrp.bom.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first BOM stage
            </p>
            <p>
                Stages are used to organize the components
                in BOM for lot/serial number according to production phases.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_mrp_bom_stage"
              name="BOM stages"
              parent="mrp.menu_mrp_configuration"
              action="action_mrp_bom_stage"
              sequence="50"/>
</odoo>
