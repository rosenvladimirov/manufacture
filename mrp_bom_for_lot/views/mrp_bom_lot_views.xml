<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_mrp_bom_lot_tree" model="ir.ui.view">
        <field name="name">mrp.bom.lot.tree</field>
        <field name="model">mrp.bom.lot</field>
        <field name="arch" type="xml">
            <list string="BOM for Lot/Serial number" create="true" multi_edit="1" open_form_view="1">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="lot_name"/>
                <field name="master_bom_id"/>
                <field name="product_qty"/>
                <field name="state" decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'cancel'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_mrp_bom_lot_form" model="ir.ui.view">
        <field name="name">mrp.bom.lot.form</field>
        <field name="model">mrp.bom.lot</field>
        <field name="arch" type="xml">
            <form string="BOM for Lot/Serial number">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_load_from_master" string="Load from master BOM"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Return to draft"
                            type="object"
                            invisible="state != 'cancel'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ['done', 'cancel']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_tmpl_id"
                                   readonly="state != 'draft'"/>
                            <field name="product_id"
                                   readonly="state != 'draft'"/>
                            <field name="master_bom_id"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="lot_id"
                                   readonly="state != 'draft'"/>
                            <field name="lot_name"
                                   invisible="lot_id"
                                   readonly="state != 'draft'"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Components" name="components">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="master_bom_line_id" column_invisible="1" force_save="1"/>
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="master_product_qty" readonly="1" force_save="1"/>
                                    <field name="product_qty"/>
                                    <field name="qty_difference"
                                           decoration-danger="qty_difference != 0"
                                           decoration-success="qty_difference == 0"/>
                                    <field name="product_uom_id" readonly="1" force_save="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comment" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mrp_bom_lot" model="ir.actions.act_window">
        <field name="name">BOM for Lot/Serial number</field>
        <field name="res_model">mrp.bom.lot</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first BOM for lot/serial number
            </p>
            <p>
                BOM for Lot/Serial number allows you to adjust the quantities of
                components from the master BOM for a specific lot or serial number.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_mrp_bom_lot"
              name="BOM for Lot/Serial number"
              parent="mrp.menu_mrp_bom"
              action="action_mrp_bom_lot"
              sequence="20"/>
</odoo>
