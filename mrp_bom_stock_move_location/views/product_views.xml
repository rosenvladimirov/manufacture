<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- base structure of product.template, common with product.product -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Create Transfer base BOM" type="action"
                    name="%(mrp_bom_stock_move_location.wiz_bom_tmpl_stock_move_location_action)d"
                    attrs="{'invisible': [('product_variant_count', '&lt;=', 1)]}"
                    context="{'default_product_tmpl_ids': [active_id]}"
                    groups="product.group_product_variant"/>
            </xpath>
        </field>
    </record>
    </data>
</odoo>