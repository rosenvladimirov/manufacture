<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_wiz_bom_stock_move_location" model="ir.ui.view">
    <field name="name">wiz.wiz.bom.stock.move.location.form</field>
    <field name="model">wiz.bom.stock.move.location</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
            <div class="oe_button_box" name="button_box"/>
            <div>
                <label for="edit_locations">
                    Edit Locations
                </label>
                <field name="edit_locations" widget="boolean_toggle"/>
            </div>
            <group name="picking_type">
                <field name="picking_type_id" options="{'no_create': True}"/>
            </group>
            <group name="main">
                <field name="origin_location_disable" invisible="1"/>
                <field name="origin_location_id" attrs="{'readonly': [('origin_location_disable', '=', True)]}"/>
                <field name="destination_location_disable" invisible="True"/>
                <field name="destination_location_id" attrs="{'readonly': [('destination_location_disable', '=', True)]}"/>
                <field name="destination_owner_disable" force_save="1" invisible="True"/>
                <field name="owner_id" force_save="1" attrs="{'readonly': [('destination_owner_disable', '=', True)]}"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="product_qty"/>
            </group>
            <group name="product_templates" string="Product templates" invisible="1">
                <field name="product_tmpl_ids" widget="many2many_tags" nolabel="1" invisible="1"/>
            </group>
            <group name="products" string="Products" invisible="1">
                <field name="product_ids" widget="many2many_tags" nolabel="1" invisible="1"/>
            </group>
            <group name="boms" string="Boms" invisible="1">
                <field name="bom_ids" widget="many2many_tags" nolabel="1" invisible="1" readonly="1"/>
                <field name="bom_line_ids" nolabel="1" invisible="1"/>
            </group>
            <group name="lines">
                <field name="stock_move_location_line_ids" nolabel="1" widget="one2many_list" mode="tree,kanban">
                    <tree string="Inventory Details" editable="bottom" decoration-info="product_uom_qty != max_quantity"
                        decoration-danger="(product_uom_qty &lt; 0) or (product_uom_qty > max_quantity)">
                        <field name="product_id"  domain="[('type','=','product')]"/>
                        <field name="product_uom" string="UoM" groups="product.group_uom"/>
                        <field name="location_id" readonly="1" force_save="1"/>
                        <field name="location_dest_id" readonly="1" force_save="1"/>
                        <field name="owner_id" readonly="1" force_save="1"/>
                        <field name="package_id" options="{'no_create': True}"/>
                        <field name="lot_id" domain="[('id', 'in', lot_ids)]" context="{'default_product_id': product_id}"
                             groups="stock.group_production_lot" options="{'no_create': True}"/>
                        <field name="product_uom_qty" force_save="1"/>
                        <field name="exclude_product_uom_qty" force_save="1"/>
                        <field name="real_product_uom_qty"/>
                        <field name="lot_ids" invisible="1"/>
                        <field name="custom" invisible="1" />
                        <field name="max_quantity" attrs="{'readonly': [('custom', '!=', True)]}" force_save="1"/>
                        <field name="bom_line_id" invisible="1"/>
                    </tree>
                    <kanban class="o_kanban_mobile">
                        <templates>
                            <t t-name="kanban-box">
                                <div t-attf-class="oe_kanban_global_click">
                                    <div class="o_kanban_record_body">
                                        <field name="product_id"/>
                                        <field name="product_uom"/>
                                        <field name="lot_id" groups="stock.group_production_lot"/>
                                        <field name="location_id"/>
                                        <field name="location_dest_id"/>
                                        <field name="product_uom_qty"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_right">
                                            <span><field name="product_uom_qty"/></span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </field>
            </group>
            <footer>
                <button name="action_move_location" string="Planned Transfer" type="object" class="btn-primary" context="{'planned': True}"/>
                <button special="cancel" string="Cancel" class="btn-default"/>
            </footer>
        </sheet>
      </form>
    </field>
  </record>

<!--  <record id="wiz_mrp_stock_move_location_action" model="ir.actions.act_window">-->
<!--    <field name="name">Move from location...</field>-->
<!--    <field name="res_model">wiz.mrp.stock.move.location</field>-->
<!--    <field name="view_mode">form</field>-->
<!--    <field name="target">new</field>-->
<!--  </record>-->

   <act_window name="Create stock move on BOM base"
        res_model="wiz.bom.stock.move.location"
        src_model="product.product"
        view_mode="form"
        target="new"
        key2="client_action_multi"
        id="wiz_bom_stock_move_location_action"
        view_id="view_wiz_bom_stock_move_location"/>

    <act_window name="Create stock move on BOM base"
        res_model="wiz.bom.stock.move.location"
        src_model="product.template"
        view_mode="form"
        target="new"
        key2="client_action_multi"
        id="wiz_bom_tmpl_stock_move_location_action"
        view_id="view_wiz_bom_stock_move_location"/>
</odoo>
