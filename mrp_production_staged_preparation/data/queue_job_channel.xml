<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ADR-0098 / ADR-0100: „Подготви за производство“ във фонова задача,
         в собствен канал — да не чака зад вноса на ЛогиКал и обратно. -->
    <record id="channel_staged_preparation" model="queue.job.channel">
        <field name="name">staged_preparation</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
    </record>
    <record id="job_function_staged_prepare" model="queue.job.function">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="method">_staged_prepare_job</field>
        <field name="channel_id" ref="channel_staged_preparation"/>
    </record>
</odoo>
