<odoo>

    <record id="mrp_production_form_staged_preparation"
            model="ir.ui.view">
        <field name="name">mrp.production.form.staged.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Inject staged_preparation_enabled flag (hidden) so views/buttons can use it. -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="staged_preparation_enabled" invisible="1"/>
            </xpath>

            <!-- Prepare button: видим само при state='preparation' + enabled -->
            <xpath expr="//header" position="inside">
                <button name="action_prepare_production"
                        type="object"
                        string="Prepare for Production"
                        class="oe_highlight"
                        invisible="(not staged_preparation_enabled) or state != 'preparation'"
                        groups="mrp.group_mrp_user"/>
            </xpath>

        </field>
    </record>

</odoo>
