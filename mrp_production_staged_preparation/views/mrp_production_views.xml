<odoo>

    <record id="mrp_production_form_staged_preparation"
            model="ir.ui.view">
        <field name="name">mrp.production.form.staged.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Inject staged_preparation_enabled + staged_released (hidden) so
                 views/buttons/ribbon can use them. -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="staged_preparation_enabled" invisible="1"/>
                <field name="staged_released" invisible="1"/>
                <field name="staged_prep_job_state" invisible="1"/>
            </xpath>

            <!-- ADR-0098 / ADR-0100: подготовката е фонова задача — докато
                 върви и ако падне, се казва най-горе на формата. -->
            <xpath expr="//sheet" position="before">
                <!-- Като при вноса от ЛогиКал: етап + процент, обновяват се
                     сами през l10n_bg_live_refresh. -->
                <div class="alert alert-info d-flex align-items-center gap-2 mb-0"
                     role="status" invisible="staged_prep_job_state not in ('queued', 'releasing')">
                    <i class="fa fa-cog fa-spin" title="Working"/>
                    <span>Preparation is running in the background.</span>
                    <field name="staged_prep_stage" readonly="1" nolabel="1" class="mb-0"/>
                    <field name="staged_prep_progress" widget="progressbar" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-0"
                     role="status" invisible="staged_prep_job_state != 'awaiting'">
                    <i class="fa fa-scissors" title="Cutting"/>
                    <span>The cutting is ready and awaits your approval.</span>
                    <button name="action_staged_review_cutting" type="object"
                            string="Review the Cutting" class="btn btn-sm btn-primary ms-auto"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="staged_prep_job_state != 'failed'">
                    <strong>Preparation failed — nothing was committed.</strong>
                    <field name="staged_prep_error" readonly="1" nolabel="1"/>
                </div>
            </xpath>

            <!-- Бадж „Released to floor" (подготвено за цеха): ъглова лента.
                 ⚠️ ПЪРВО дете на sheet, не последно. `position="inside"` слага
                 widget-а НАКРАЯ — тоест след notebook-а — и лентата се рендира
                 долу вдясно, в списъка с компоненти, вместо в горния ъгъл.
                 Мерено на WH/MO/00230; Любо: „много ме дразни". Ъгловата лента
                 се позиционира спрямо СОБСТВЕНИЯ си контейнер, затова мястото ѝ
                 в XML-а решава къде излиза. -->
            <xpath expr="//sheet/*[1]" position="before">
                <widget name="web_ribbon" title="Released" bg_color="text-bg-success"
                        invisible="not staged_released"/>
            </xpath>

            <!-- Prepare button: видим само при state='preparation' + enabled -->
            <xpath expr="//header" position="inside">
                <button name="action_prepare_production"
                        type="object"
                        string="Prepare for Production"
                        class="oe_highlight"
                        invisible="(not staged_preparation_enabled) or state != 'preparation' or staged_released or staged_prep_job_state in ('queued', 'awaiting', 'releasing')"
                        groups="mrp.group_mrp_user"/>
                <!-- ADR-0098 (Любо 21.10): стартът е отделна стъпка след
                     подготовката — подготвено (released), още в Preparation. -->
                <button name="action_staged_start"
                        type="object"
                        string="Start Production"
                        class="oe_highlight"
                        invisible="(not staged_preparation_enabled) or (not staged_released) or state != 'preparation' or staged_prep_job_state in ('queued', 'awaiting', 'releasing')"
                        groups="mrp.group_mrp_user"/>
                <!-- Откат на подготовката: връща в draft, маха пикинга към
                     Pre-Production и връща движенията на едностъпково.
                     Видим само след като подготовката е минала. -->
                <button name="action_unprepare_production_wizard"
                        type="object"
                        string="Undo Preparation"
                        invisible="(not staged_preparation_enabled) or (not staged_released) or state in ('done', 'cancel')"
                        groups="mrp.group_mrp_user"/>
            </xpath>

        </field>
    </record>

    <!-- LIST batch бутон: „Prepare for Production" веднага СЛЕД „Plan" в
         header-а на списъка с МО. Действа върху маркираните записи (дневна
         партида) → 1 агрегиран Stock→Pre-Production трансфер. -->
    <record id="mrp_production_list_staged_preparation" model="ir.ui.view">
        <field name="name">mrp.production.list.staged.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_plan']" position="after">
                <button name="action_prepare_production_batch"
                        type="object"
                        string="Prepare for Production"
                        groups="mrp.group_mrp_user"/>
                <button name="action_staged_review_cutting"
                        type="object"
                        string="Approve Cutting"
                        groups="mrp.group_mrp_user"/>
                <button name="action_staged_start"
                        type="object"
                        string="Start Production"
                        groups="mrp.group_mrp_user"/>
                <!-- Откат за маркираната партида. Методът сам филтрира
                     неподходящите редове, за да не спира заради един. -->
                <button name="action_unprepare_production_wizard"
                        type="object"
                        string="Undo Preparation"
                        groups="mrp.group_mrp_user"/>
            </xpath>
            <!-- Бадж/декорация: подготвените (released) редове в зелено + колона. -->
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-success">staged_released</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="staged_released" optional="show" string="Released"
                       widget="boolean_toggle" readonly="1"/>
                <field name="staged_prep_job_state" optional="show" widget="badge"
                       decoration-info="staged_prep_job_state in ('queued', 'releasing')"
                       decoration-warning="staged_prep_job_state == 'awaiting'"
                       decoration-danger="staged_prep_job_state == 'failed'"/>
            </xpath>
            <!-- Reference се свиваше до няколко символа, защото полето е без
                 зададена ширина и губи борбата за място. Реалната дължина е
                 11 знака (WH/MO/00016) → 150px е с резерв. -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="width">100px</attribute>
            </xpath>
        </field>
    </record>

    <!-- №119: „Plan“ от списъка носи знак, че е натиснат оттам — след него
         списъкът се отваря наново с филтъра „In Preparation“. -->
    <record id="mrp_production_tree_plan_to_preparation" model="ir.ui.view">
        <field name="name">mrp.production.list.plan.to.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_plan']" position="attributes">
                <attribute name="context">{'staged_plan_from_list': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Филтър „Released to floor" + групиране в търсенето на МО. -->
    <record id="mrp_production_search_staged_preparation" model="ir.ui.view">
        <field name="name">mrp.production.search.staged.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="staged_released" string="Released to Floor"
                        domain="[('staged_released', '=', True)]"/>
                <filter name="staged_in_preparation" string="In Preparation"
                        domain="[('state', '=', 'preparation')]"/>
            </xpath>
            <!-- Ядреният „To Do" не знае за статус preparation → операторът
                 губеше МО-то от поглед в момента, в който започне работа по
                 него. Пренаписваме domain-а тук, а НЕ в mrp — ядреният view се
                 възстановява при всеки -u на mrp. -->
            <xpath expr="//filter[@name='todo']" position="attributes">
                <attribute name="domain">[('state', 'in', ('draft', 'confirmed', 'preparation', 'progress', 'to_close'))]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
