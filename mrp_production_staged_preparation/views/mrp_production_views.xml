<odoo>

    <record id="mrp_production_form_staged_preparation"
            model="ir.ui.view">
        <field name="name">mrp.production.form.staged.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Inject staged_preparation_enabled + staged_released (hidden) so
                 views/buttons/ribbon can use them. -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="staged_preparation_enabled" invisible="1"/>
                <field name="staged_released" invisible="1"/>
            </xpath>

            <!-- Бадж „Released to floor" (подготвено за цеха): ъглова лента. -->
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Released" bg_color="text-bg-success"
                        invisible="not staged_released"/>
            </xpath>

            <!-- Prepare button: видим само при state='preparation' + enabled -->
            <xpath expr="//header" position="inside">
                <button name="action_prepare_production"
                        type="object"
                        string="Prepare for Production"
                        class="oe_highlight"
                        invisible="(not staged_preparation_enabled) or state != 'preparation'"
                        groups="mrp.group_mrp_user"/>
            </xpath>

        </field>
    </record>

    <!-- LIST batch бутон: „Prepare for Production" веднага СЛЕД „Plan" в
         header-а на списъка с МО. Действа върху маркираните записи (дневна
         партида) → 1 агрегиран Stock→Pre-Production трансфер. -->
    <record id="mrp_production_list_staged_preparation" model="ir.ui.view">
        <field name="name">mrp.production.list.staged.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_plan']" position="after">
                <button name="action_prepare_production_batch"
                        type="object"
                        string="Prepare for Production"
                        groups="mrp.group_mrp_user"/>
            </xpath>
            <!-- Бадж/декорация: подготвените (released) редове в зелено + колона. -->
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-success">staged_released</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="staged_released" optional="show" string="Released"
                       widget="boolean_toggle" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Филтър „Released to floor" + групиране в търсенето на МО. -->
    <record id="mrp_production_search_staged_preparation" model="ir.ui.view">
        <field name="name">mrp.production.search.staged.preparation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="staged_released" string="Released to Floor"
                        domain="[('staged_released', '=', True)]"/>
                <filter name="staged_in_preparation" string="In Preparation"
                        domain="[('state', '=', 'preparation')]"/>
            </xpath>
        </field>
    </record>

</odoo>
