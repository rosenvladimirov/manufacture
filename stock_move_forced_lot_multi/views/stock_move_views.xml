<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stock Move Form View -->
    <record id="view_move_form_forced_lot" model="ir.ui.view">
        <field name="name">stock.move.form.forced.lot</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <field name="product_uom_qty" position="after">
                <field name="forced_lot_ids"
                       widget="many2many_tags"
                       domain="[('product_id', '=', product_id)]"
                       context="{'default_product_id': product_id}"
                       options="{'no_create': False, 'no_quick_create': True}"/>
                <field name="forced_lot_extra_data"
                       groups="base.group_no_one"
                       readonly="1"
                       widget="json"/>
            </field>
        </field>
    </record>

    <!-- Stock Move Tree View -->
    <record id="view_move_tree_forced_lot" model="ir.ui.view">
        <field name="name">stock.move.tree.forced.lot</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="product_uom_qty" position="after">
                <field name="forced_lot_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Stock Picking Form - Move Lines -->
    <record id="view_picking_form_forced_lot" model="ir.ui.view">
        <field name="name">stock.picking.form.forced.lot</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="after">
                <field name="forced_lot_ids"
                       widget="many2many_tags"
                       column_invisible="True"
                       optional="hide"/>
            </xpath>
            <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/list" position="inside">
                <button name="action_open_forced_lot_wizard"
                        type="object"
                        class="btn btn-sm o_icon_button"
                        icon="fa-cubes"
                        title="Add Forced Lots"
                        width="20"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="forced_lots" string="Forced Lots">
                    <field name="forced_lot_ids" nolabel="1">
                        <list>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="ref"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
