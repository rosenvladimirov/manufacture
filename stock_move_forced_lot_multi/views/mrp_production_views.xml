<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MRP Production Form View - Raw Materials -->
    <record id="mrp_production_form_forced_lot" model="ir.ui.view">
        <field name="name">mrp.production.form.forced.lot</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add forced_lot_ids to the raw materials (move_raw_ids) tree -->
            <xpath expr="//page[@name='components']//field[@name='move_raw_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="forced_lot_ids"
                       widget="many2many_tags"
                       domain="[('product_id', '=', product_id)]"
                       context="{'default_product_id': product_id, 'default_company_id': company_id}"
                       options="{'no_create': False, 'no_quick_create': True}"
                       optional="show"
                       column_invisible="parent.state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="forced_lots" string="Forced Lots">
                    <field name="forced_lot_ids" nolabel="1">
                        <list>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="ref"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- MRP Production - Components Tab (alternative xpath if above doesn't work) -->
    <record id="mrp_production_form_forced_lot_alt" model="ir.ui.view">
        <field name="name">mrp.production.form.forced.lot.alt</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Components section in form view -->
            <xpath expr="//field[@name='move_raw_ids']//field[@name='quantity']" position="after">
                <field name="forced_lot_ids"
                       widget="many2many_tags"
                       domain="[('product_id', '=', product_id)]"
                       optional="show"
                       invisible="not product_id"/>
            </xpath>
        </field>
    </record>

</odoo>
