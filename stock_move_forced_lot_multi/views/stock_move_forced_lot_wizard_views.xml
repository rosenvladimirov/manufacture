<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_forced_lot_wizard_form" model="ir.ui.view">
        <field name="name">stock.move.forced.lot.wizard.form</field>
        <field name="model">stock.move.forced.lot.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Forced Lots">
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="lot_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Apply" type="object" name="action_apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
