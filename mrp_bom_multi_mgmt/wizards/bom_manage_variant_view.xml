<odoo>

    <record model="ir.ui.view" id="bom_manage_variant_form">
        <field name="model">bom.manage.variant</field>
        <field name="arch" type="xml">
            <form string="Manage Product Variants">
                <group>
                    <field name="product_tmpl_id" colspan="4"
                           domain="[('attribute_line_ids', '!=', False)]"
                           options="{'no_create': True}"
                    />
                </group>
                <group>
                    <field name="product_attribute_ids"
                           nolabel="1" colspan="2"
                           attrs="{'invisible': ['|', ('id','!=',False), ('product_attribute_ids', '=', [])]}"
                           context="{'default_product_tmpl_id': product_tmpl_id, 'show_price_extra': True, 'show_attribute': False}">
                        <tree create="0" delete="0" editable="1">
                            <field name="attribute_id" />
                            <field name="possible_value_ids" widget="many2many_tags" invisible="1"/>
                            <field name="product_tmpl_id" invisible="1"/>
                            <field name="value_id"
                                   context="{'show_attribute': False, 'default_attribute_id': attribute_id, 'template_for_attribute_value': product_tmpl_id}"
                            />
                            <field name="system_all"/>
                            <field name="type_attribute" invisible="1"/>
<!--                            <field name="price_extra"-->
<!--                                   invisible="not context.get('show_price_extra', False)"/>-->
                        </tree>
                    </field>
                </group>
                <group name="other">
                    <field name="show_mrp_attributes" invisible="1"/>
                    <field name="routing_id" invisible="1"/>
                    <field name="operation_id" domain="[('routing_id', '=', routing_id)]"/>
                </group>
                <group attrs="{'invisible': [('show_mrp_attributes', '=', False)]}">
                    <field name="product_uom_qty" attrs="{'invisible': [('show_mrp_attributes', '=', False)]}"/>
                </group>
                <group>
                    <field name="mrp_product_tmpl_id" colspan="4"
                           domain="[('bom_count', '>', 0), ('attribute_line_ids', '!=', False)]"
                           options="{'no_create': True}"
                           readonly="1"
                    />
                    <field name="bom_id" invisible="1"/>
                </group>
                <group>
                    <field name="mrp_product_attribute_ids"
                           nolabel="1" colspan="2"
                           attrs="{'invisible': ['|', ('id','!=',False), ('mrp_product_attribute_ids', '=', [])]}"
                           context="{'default_product_tmpl_id': mrp_product_tmpl_id, 'show_price_extra': True, 'show_attribute': False}">
                        <tree create="0" delete="0" editable="1">
                            <field name="attribute_id"/>
                            <field name="possible_value_ids" widget="many2many_tags" invisible="1"/>
                            <field name="product_tmpl_id" invisible="1"/>
                            <field name="value_id" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"
                                   context="{'show_attribute': False, 'default_attribute_id': attribute_id, 'template_for_attribute_value': product_tmpl_id}"
                            />
                            <field name="system_all"/>
                            <field name="type_attribute" invisible="1"/>
<!--                            <field name="price_extra"-->
<!--                                   invisible="not context.get('show_price_extra', False)"/>-->
                        </tree>
                    </field>
                </group>
                <field name="variant_line_ids"
                       widget="x2many_2d_matrix"
                       field_x_axis="value_x"
                       field_y_axis="value_y"
                       field_value = "product_uom_qty"
                       x_axis_clickable="0"
                       y_axis_clickable="0">
                    <tree>
                        <field name="value_x"/>
                        <field name="value_y"/>
                        <field name="product_uom_qty"/>
                    </tree>
                </field>
<!--                <field name="bom_line_ids" widget="one2many_list" readonly="1">-->
<!--                    <tree string="Components" editable="bottom" default_order="id desc">-->
<!--                        <field name="product_id"/>-->
<!--                        <field name="product_qty"/>-->
<!--                        <field name="product_uom_id" options="{'no_open':True,'no_create':True}" groups="product.group_uom"/>-->
<!--                        <field name="attribute_value_ids" widget="many2many_tags" options="{'no_create': True}" groups="product.group_product_variant"/>-->
<!--                        <field name="operation_id" groups="mrp.group_mrp_routings" options="{'no_quick_create':True,'no_create_edit':True}"/>-->
<!--                    </tree>-->
<!--                </field>-->
                <footer>
                    <button name="button_transfer_to_bom"
                            type="object"
                            string="Transfer to BOM"
                            class="oe_highlight"
                    />
                    <button class="oe_link"
                            special="cancel"
                            string="Cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_bom_manage_variant">
        <field name="name">Manage variants</field>
        <field name="res_model">bom.manage.variant</field>
        <field name="view_mode">form</field>
        <field name="view_type">form</field>
        <field name="target">new</field>
    </record>

</odoo>
