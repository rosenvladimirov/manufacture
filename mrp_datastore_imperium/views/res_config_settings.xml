<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imperium_res_config_settings" model="ir.ui.view">
        <field name="name">imperium.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='mrp']" position="inside">
                <h2>DataStore Imperium config</h2>
                <div class="row mt16 o_settings_container" id="imperium">
                    <div class="col-xs-12 col-md-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <div class="row">
                                <label for="imperium_server_url" class="col-md-5 o_light_label"/>
                                <field name="imperium_server_url" widget="url"/>
                            </div>                           
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
