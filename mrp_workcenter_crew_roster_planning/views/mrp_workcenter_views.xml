<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ротацията на центъра: от нея идват смените (календарът) и нарядът -->
    <record id="mrp_workcenter_view_form_crew_rotation" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.crew.rotation</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <field name="resource_calendar_id" position="before">
                <field name="crew_rotation_id"/>
            </field>
            <field name="resource_calendar_id" position="attributes">
                <attribute name="readonly">crew_rotation_id</attribute>
            </field>
        </field>
    </record>
</odoo>
