<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_line_view_notes_form" model="ir.ui.view">
        <field name="name">mrp.bom.notes.form</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='sequence']" position="after">
                <field name="id" widget="open_tab"/>
            </xpath>
        </field>
    </record>
</odoo>
