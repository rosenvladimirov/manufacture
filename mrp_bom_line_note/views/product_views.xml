<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_template_property_form" model="ir.ui.view">
            <field name="name">product.template.stock.property.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <group name="description" position="after">
                    <group>
                        <group string="Description for Manufacture Orders">
                            <field name="ref_note_manufacture"/>
                            <field name="description_manufacture" nolabel="1" placeholder="This note will show up on delivery orders."/>
                        </group>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>