<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_view_consumptions" model="ir.ui.view">
        <field name="name">mrp.production.view.consumptions.wiz</field>
        <field name="model">mrp.production.view.consumptions</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="view_by"/>
                    <field name="production_id" invisible="1"/>
                </group>
                <field name="line_ids" widget="x2many_2d_matrix" field_x_axis="workorder_id" field_y_axis="product_id" field_value="product_qty" readonly="1">
                    <tree>
                        <field name="product_id"/>
                        <field name="workorder_id"/>
                        <field name="product_qty"/>
                    </tree>
                </field>
                <footer>
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>