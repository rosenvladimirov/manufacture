<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_line_formula_template_tree" model="ir.ui.view">
        <field name="name">mrp.bom.line.formula.template.tree</field>
        <field name="model">mrp.bom.line.formula.template</field>
        <field name="arch" type="xml">
            <list string="BoM Line Formula Templates">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_mrp_bom_line_formula_template_form" model="ir.ui.view">
        <field name="name">mrp.bom.line.formula.template.form</field>
        <field name="model">mrp.bom.line.formula.template</field>
        <field name="arch" type="xml">
            <form string="BoM Line Formula Template">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="active" />
                    </group>
                    <group>
                        <field name="quantity_formula" placeholder="quantity = product_uom_qty * 1.0" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_bom_line_formula_template" model="ir.actions.act_window">
        <field name="name">BoM Line Formula Templates</field>
        <field name="res_model">mrp.bom.line.formula.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mrp_bom_line_formula_template"
              name="BoM Line Formula Templates"
              parent="mrp.menu_mrp_config"
              action="action_mrp_bom_line_formula_template"
              sequence="80" />

    <record id="mrp_bom_line_view_form_formula_template" model="ir.ui.view">
        <field name="name">Add formula template field to BoM Line form view</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']/.." position="after">
                <field name="formula_template_id" />
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_form_view_formula_template" model="ir.ui.view">
        <field name="name">Add formula template field to BoM form view</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='bom_line_ids']/list/field[@name='product_qty']"
                position="after"
            >
                <field name="formula_template_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
