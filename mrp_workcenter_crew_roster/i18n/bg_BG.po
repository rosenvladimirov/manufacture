msgstr "Периодът на наряда може да е най-много три месеца."

#. module: mrp_workcenter_crew_roster
#: code:addons/mrp_workcenter_crew_roster/models/mrp_workcenter.py:0
msgid "different crews"
msgstr "различни бригади"

#. module: mrp_workcenter_crew_roster
#: model:ir.model.fields,field_description:mrp_workcenter_crew_roster.field_mrp_routing_workcenter__crew_share
#: model:ir.model.fields,field_description:mrp_workcenter_crew_roster.field_mrp_workorder__crew_share
