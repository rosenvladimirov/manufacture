<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Многофирмено правило за наряда (Р24, TECH_DESIGN §2): глобално,
             по образеца на mrp_production_rule — важи за всички групи. -->
        <record id="mrp_workcenter_roster_rule_company" model="ir.rule">
            <field name="name">Crew roster: multi-company</field>
            <field name="model_id" ref="model_mrp_workcenter_roster"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- Партидата на преплaнирането и редовете ѝ — по фирма (TECH_DESIGN §2). -->
        <record id="mrp_workcenter_replan_batch_rule_company" model="ir.rule">
            <field name="name">Replan batch: multi-company</field>
            <field name="model_id" ref="model_mrp_workcenter_replan_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="mrp_workcenter_replan_batch_line_rule_company" model="ir.rule">
            <field name="name">Replan batch line: multi-company</field>
            <field name="model_id" ref="model_mrp_workcenter_replan_batch_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- Ключалката на пистата (Р38, §9.6) — по фирма. -->
        <record id="mrp_workcenter_lane_lock_rule_company" model="ir.rule">
            <field name="name">Lane lock: multi-company</field>
            <field name="model_id" ref="model_mrp_workcenter_lane_lock"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
