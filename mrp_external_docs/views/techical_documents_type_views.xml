<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="technical_documents_type_form_view" model="ir.ui.view">
            <field name="name">technical.documents.type.form.view</field>
            <field name="model">technical.documents.type</field>
            <field name="arch" type="xml">
                <form string="Technical document type">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="technical_documents_type_tree_view" model="ir.ui.view">
            <field name="name">technical.documents.type.tree.view</field>
            <field name="model">technical.documents.type</field>
            <field name="arch" type="xml">
                <tree string="Technical document type">
                    <field name="code"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="technical_documents_type_action" model="ir.actions.act_window">
            <field name="name">Technical document type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">technical.documents.type</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem action="technical_documents_type_action" id="menu_documents_type"
            parent="mrp.menu_mrp_bom"
            sequence="999"
            groups="mrp.group_mrp_manager"/>
    </data>
</odoo>
