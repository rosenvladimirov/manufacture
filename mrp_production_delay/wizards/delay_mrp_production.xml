<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_delay_wizard" model="ir.ui.view">
        <field name="name">mrp.production.delay.form</field>
        <field name="model">mrp.production.delay</field>
        <field name="arch" type="xml">
             <form string="Merge manufacture orders">
                <strong>Starting Mark As Done on background service...</strong>
                <footer>
                    <button name="action_delay_mrp_production" string="Mark as Done" type="object"
                    class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window 
        id="action_delay_mrp_production_wizard"
        multi="True"
        key2="client_action_multi" 
        name="Mark is done manufacture orders"
        res_model="mrp.production.delay"
        src_model="mrp.production"
        view_mode="form" 
        target="new" 
        view_type="form"
        view_id="view_mrp_production_delay_wizard" />

</odoo>