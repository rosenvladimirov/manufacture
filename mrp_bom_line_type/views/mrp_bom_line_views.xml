<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add line_type to BOM form view (in the components section) -->
    <record id="view_mrp_bom_form_line_type" model="ir.ui.view">
        <field name="name">mrp.bom.form.line.type</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_uom_id']" position="after">
                <field name="line_type"/>
            </xpath>
        </field>
    </record>
</odoo>
