<odoo>
    <record id="view_distribution_log_tree" model="ir.ui.view">
        <field name="name">mrp.production.coefficient.log.tree</field>
        <field name="model">mrp.production.coefficient.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="user_id" />
                <field name="product_id" />
                <field name="coefficient" widget="percentage" />
                <field name="planned_qty" />
                <field name="product_uom_id" />
                <field name="base_distribution_qty" />
            </list>
        </field>
    </record>

    <record id="view_distribution_log_form" model="ir.ui.view">
        <field name="name">mrp.production.coefficient.log.form</field>
        <field name="model">mrp.production.coefficient.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date" />
                        <field name="user_id" />
                        <field name="production_id" />
                        <field name="move_id" />
                        <field name="product_id" />
                        <field name="coefficient" widget="percentage" />
                        <field name="planned_qty" />
                        <field name="product_uom_id" />
                        <field name="base_distribution_qty" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
