<odoo>
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="name">Add distribution fields to BoM form view</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="main_component_id" />
                <field name="base_distribution_qty" />
            </xpath>
            <xpath
                expr="//field[@name='bom_line_ids']/*[self::list or self::tree]/field[@name='product_qty']"
                position="after"
            >
                <field
                    name="distribution_coefficient"
                    widget="percentage"
                    optional="show"
                    readonly="is_distribution_master"
                />
            </xpath>
            <xpath
                expr="//field[@name='bom_line_ids']/*[self::list or self::tree]"
                position="inside"
            >
                <field name="is_distribution_master" column_invisible="1" force_save="1" />
            </xpath>
        </field>
    </record>
</odoo>
