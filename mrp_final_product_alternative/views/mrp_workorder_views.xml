<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="mrp_production_workorder_form_view_inherit">
        <field name="name">mrp.production.work.order.form</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workcenter_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[1]" position="inside">
                <field name="mrp_production_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Trusted lots" attrs="{'invisible': [('alternative_stock_move_ids', '=', [])]}">
                    <field name="alternative_stock_move_ids" context="{'default_workorder_id': active_id, 'default_production_id': production_id, 'default_product_id': product_id}">
                        <tree>
                            <field name="name"/>
                            <field name="ref"/>
                            <field name="production_id"/>
                            <field name="workorder_id" domain="[('production_id', '=', production_id)]"/>
                            <field name="product_id" invisible="0"/>
                            <field name="lot_id" domain="[('product_id', '=', product_id)]" invisible="1"/>
                        </tree>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="lot_id"/>
                                        <field name="name"/>
                                        <field name="ref"/>
                                    </group>
                                    <group>
                                        <field name="workorder_id"/>
                                        <field name="production_id"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>